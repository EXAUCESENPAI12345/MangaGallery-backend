APP_NAME=Manga Gallery
APP_VERSION=1.0.0
APP_ENV=production
HOST=0.0.0.0
PORT=5000
AUTO_CREATE_TABLES=false
SECRET_KEY=generate-a-long-random-secret
JWT_SECRET_KEY=generate-another-long-random-secret
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/manga_gallery
API_PREFIX=/api
CORS_ORIGINS=https://YOUR-ADMIN-DOMAIN
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username
TELEGRAM_MINI_APP_URL=https://YOUR-MINI-APP-DOMAIN
PUBLIC_BACKEND_URL=https://YOUR-RENDER-BACKEND.onrender.com
TELEGRAM_WEBHOOK_SECRET=generate-a-random-webhook-secret
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
